      },
      "lineNumber": {
        "text": "#595959",
        "background": {
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }
      }
    },
    "syntax": {
      "number": "$hue.orange.200",
      "type": "#8f6818"
    },
    "markdown": {
      "blockQuote": "#8f6818",
      "emphasis": "#8f6818",
      "strong": "$hue.accent.200"
    }
  },
