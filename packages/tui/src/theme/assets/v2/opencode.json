{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "rose",
      "emerald",
      "violet",
      "amber",
      "cyan",
      "orange",
      "lime"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.100",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.100",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.100",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "#e0af68"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.600",
          "$focused": "$hue.neutral.500",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.500"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#1a1e2b"
    },
    "scrollbar": {
      "base": "#2a3045"
    },
    "diff": {
      "text": {
        "added": "#58c496",
        "removed": "#e06c88",
        "context": "#687094",
        "hunkHeader": "#7aa2f7"
      },
      "background": {
        "added": "#0c1816",
        "removed": "#1c0d14",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#73daca",
        "removed": "#f7768e"
      },
      "lineNumber": {
        "text": "#4a5270",
        "background": {
          "added": "#091210",
          "removed": "#14090e"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.violet.200",
      "function": "$hue.interactive.200",
      "variable": "$hue.neutral.100",
      "string": "$hue.green.200",
      "number": "#e0af68",
      "type": "$hue.cyan.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.interactive.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "#e0af68",
      "emphasis": "#e0af68",
      "strong": "$hue.accent.200",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.100"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high",
            "$focused": "$background.raised.max"
          }
        }
      }
    }
  },
